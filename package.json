{
  "name": "parallel-translate",
  "version": "0.1.0",
  "description": "Bilingual web page translation with your own LLM API",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "postinstall": "wxt prepare",
    "build:e2e": "wxt build --mode e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "pdfjs-dist": "6.4.299"
  }
}
